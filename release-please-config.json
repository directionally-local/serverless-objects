{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "packages": {
    "packages/cli": {
      "release-type": "node",
      "package-name": "serverless-objects",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/cli'].version"
        },
        {
          "type": "json",
          "path": "/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "generic",
          "path": "/deploy/compose/Dockerfile"
        },
        {
          "type": "generic",
          "path": "/deploy/compose/compose.yaml"
        }
      ]
    }
  }
}
