{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "packages": {
    "packages/cli": {
      "release-type": "node",
      "package-name": "serverless-objects",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/cli'].version"
        },
        {
          "type": "generic",
          "path": "/deploy/compose/Dockerfile"
        },
        {
          "type": "generic",
          "path": "/deploy/compose/compose.yaml"
        }
      ]
    },
    "packages/hotcell": {
      "release-type": "node",
      "package-name": "@serverless-objects/hotcell",
      "component": "hotcell",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/hotcell'].version"
        }
      ]
    },
    "packages/autopilot": {
      "release-type": "node",
      "package-name": "@serverless-objects/autopilot",
      "component": "autopilot",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/autopilot'].version"
        }
      ]
    }
  }
}
