# Copy to .env. Object-store credentials for celld (and for SeaweedFS with
# the local-s3 profile). Never put them in sobjects.toml.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me-to-a-long-random-secret
# Bucket the local-s3 profile creates; must match [celld].bucket.
LOCAL_BUCKET=serverless-objects
